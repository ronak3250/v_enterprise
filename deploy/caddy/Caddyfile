# Caddyfile for Vinit Enterprise
# Replace vinitenterprise.in with your actual domain

vinitenterprise.in, www.vinitenterprise.in {
    root * /var/www/vinit_enterprise/build/web
    file_server

    # SPA Fallback: try file, then try dir, otherwise rewrite to /index.html
    try_files {path} {path}/ /index.html

    # Enable Gzip and Zstandard compression
    encode gzip zstd

    # Cache control for static assets
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.webp *.svg *.woff *.woff2 *.ttf *.otf *.wasm
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # No-cache for app entry points
    @nocache {
        path /index.html /flutter_service_worker.js /version.json
    }
    header @nocache Cache-Control "no-store, no-cache, must-revalidate"

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
